{
  "name": "china-ai-providers",
  "displayName": "国内AI适配插件",
  "description": "将国内AI厂商(DeepSeek/通义千问/智谱/Kimi/小米MiMo等)注册为VS Code Copilot原生模型供应商",
  "version": "0.1.0",
  "publisher": "china-ai",
  "engines": {
    "vscode": "^1.100.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguageModelChatProvider:deepseek",
    "onLanguageModelChatProvider:qwen",
    "onLanguageModelChatProvider:zhipu",
    "onLanguageModelChatProvider:kimi",
    "onLanguageModelChatProvider:xiaomi"
  ],
  "contributes": {
    "languageModelChatProviders": [
      {
        "vendor": "deepseek",
        "displayName": "DeepSeek",
        "configuration": {
          "type": "object",
          "required": ["apiKey"],
          "properties": {
            "apiKey": {
              "type": "string",
              "title": "API Key",
              "description": "API key for DeepSeek (https://platform.deepseek.com/api_keys)",
              "secret": true
            },
            "thinkingMode": {
              "type": "string",
              "title": "Thinking Mode",
              "description": "Thinking mode for reasoning models",
              "enum": ["enabled", "disabled"],
              "enumDescriptions": ["Enabled", "Disabled"],
              "default": "enabled"
            }
          }
        }
      },
      {
        "vendor": "qwen",
        "displayName": "通义千问",
        "configuration": {
          "type": "object",
          "required": ["apiKey"],
          "properties": {
            "apiKey": {
              "type": "string",
              "title": "API Key",
              "description": "API key for Qwen (https://dashscope.console.aliyun.com/apiKey)",
              "secret": true
            },
            "thinkingMode": {
              "type": "string",
              "title": "Thinking Mode",
              "description": "Thinking mode for Qwen reasoning models",
              "enum": ["enabled", "disabled"],
              "enumDescriptions": ["Enabled", "Disabled"],
              "default": "enabled"
            }
          }
        }
      },
      {
        "vendor": "xiaomi",
        "displayName": "小米 MiMo",
        "configuration": {
          "type": "object",
          "required": ["apiKey"],
          "properties": {
            "apiKey": {
              "type": "string",
              "title": "API Key",
              "description": "API key for MiMo (https://platform.xiaomimimo.com)",
              "secret": true
            },
            "thinkingMode": {
              "type": "string",
              "title": "Thinking Mode",
              "description": "Thinking mode for MiMo reasoning models",
              "enum": ["enabled", "disabled"],
              "enumDescriptions": ["Enabled", "Disabled"],
              "default": "enabled"
            }
          }
        }
      },
      {
        "vendor": "zhipu",
        "displayName": "智谱GLM",
        "configuration": {
          "type": "object",
          "required": ["apiKey"],
          "properties": {
            "apiKey": {
              "type": "string",
              "title": "API Key",
              "description": "API key for Zhipu (https://open.bigmodel.cn/usercenter/apikeys)",
              "secret": true
            },
            "thinkingMode": {
              "type": "string",
              "title": "Thinking Mode",
              "description": "Thinking mode for Zhipu reasoning models",
              "enum": ["enabled", "disabled"],
              "enumDescriptions": ["Enabled", "Disabled"],
              "default": "enabled"
            }
          }
        }
      },
      {
        "vendor": "kimi",
        "displayName": "Kimi",
        "configuration": {
          "type": "object",
          "required": ["apiKey"],
          "properties": {
            "apiKey": {
              "type": "string",
              "title": "API Key",
              "description": "API key for Kimi (https://platform.moonshot.cn/console/api-keys)",
              "secret": true
            },
            "thinkingMode": {
              "type": "string",
              "title": "Thinking Mode",
              "description": "Kimi K2.6 thinking mode; K2.7 Code always requires thinking",
              "enum": ["enabled", "disabled"],
              "enumDescriptions": ["Enabled", "Disabled"],
              "default": "enabled"
            }
          }
        }
      }
    ],
    "commands": [
      { "command": "china-ai.showBalance", "title": "国内AI: 查看当前厂商余额" },
      { "command": "china-ai.showUsage", "title": "国内AI: 查看当前厂商今日用量" },
      { "command": "china-ai.showCostDashboard", "title": "国内AI: 用量/余额数据面板" },
      { "command": "china-ai.refreshBalance", "title": "国内AI: 刷新当前厂商余额" },
      { "command": "china-ai.refreshPricing", "title": "国内AI: 刷新定价" },
      { "command": "china-ai.switchVendor", "title": "国内AI: 切换当前厂商" },
      { "command": "china-ai.openBillingConsole", "title": "国内AI: 打开账单控制台" }
    ],
    "menus": {
      "commandPalette": [
        { "command": "china-ai.showBalance" },
        { "command": "china-ai.showUsage" },
        { "command": "china-ai.showCostDashboard" },
        { "command": "china-ai.refreshBalance" },
        { "command": "china-ai.refreshPricing" },
        { "command": "china-ai.switchVendor" },
        { "command": "china-ai.openBillingConsole" }
      ]
    },
    "configuration": {
      "title": "国内AI",
      "properties": {
        "china-ai.billing.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "是否在状态栏显示今日用量与余额"
        },
        "china-ai.billing.refreshIntervalSec": {
          "type": "number",
          "default": 60,
          "minimum": 15,
          "description": "状态栏余额自动刷新间隔（秒，最小 15）"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --preserveWatchOutput",
    "package": "npm run check-types && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --test --experimental-strip-types test/pure.test.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.100.0",
    "@vscode/test-cli": "^0.0.10",
    "@vscode/test-electron": "^2.5.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.7.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "allowScripts": {
    "esbuild@0.24.2": true
  }
}
